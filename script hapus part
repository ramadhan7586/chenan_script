-- ==========================================
-- FUNGSI SELEKSI OBJEK (KLIK DI MAP)
-- ==========================================
local function UpdateDeleteButton()
    local count = 0
    for _ in pairs(selectedObjects) do
        count = count + 1
    end
    
    if count > 0 then
        btnDelete.Text = "🗑️ HAPUS (" .. count .. ")"
        btnDelete.Visible = true
    else
        btnDelete.Visible = false
    end
end

-- Klik objek di map untuk highlight
Mouse.Button1Down:Connect(function()
    if not selectMode then return end
    
    local target = Mouse.Target
    if not target then return end
    
    -- Jangan pilih UI
    if target:IsDescendantOf(screenGui) then return end
    
    -- Jangan pilih karakter sendiri
    if character and target:IsDescendantOf(character) then return end
    
    -- Toggle seleksi
    if selectedObjects[target] then
        -- Batalkan pilihan
        if selectedObjects[target].highlight then
            selectedObjects[target].highlight:Destroy()
        end
        selectedObjects[target] = nil
        infoLabel.Text = "❌ Dibatalkan: " .. target.Name
    else
        -- Buat highlight hijau
        local highlight = Instance.new("Highlight")
        highlight.Name = "ChenanHighlight"
        highlight.FillColor = Color3.fromRGB(0, 255, 0)
        highlight.FillTransparency = 0.5
        highlight.OutlineColor = Color3.fromRGB(0, 255, 0)
        highlight.OutlineTransparency = 0
        highlight.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        
        pcall(function()
            highlight.Parent = target
        end)
        
        selectedObjects[target] = {highlight = highlight}
        infoLabel.Text = "✅ Dipilih: " .. target.Name
    end
    
    UpdateDeleteButton()
end)

-- Tombol Mode Pilih
btnSelectMode.MouseButton1Click:Connect(function()
    selectMode = not selectMode
    
    if selectMode then
        btnSelectMode.Text = "🟢 PILIH: ON"
        btnSelectMode.BackgroundColor3 = Color3.fromRGB(50, 150, 100)
        infoLabel.Text = "Klik objek di map untuk highlight"
    else
        btnSelectMode.Text = "🔴 PILIH: OFF"
        btnSelectMode.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
        
        -- Bersihkan semua seleksi
        for obj, data in pairs(selectedObjects) do
            if data.highlight then data.highlight:Destroy() end
        end
        table.clear(selectedObjects)
        UpdateDeleteButton()
        infoLabel.Text = "Mode pilih nonaktif"
    end
end)

-- Tombol Hapus
btnDelete.MouseButton1Click:Connect(function()
    local count = 0
    for obj, data in pairs(selectedObjects) do
        if obj and obj.Parent then
            -- Clone untuk undo
            local clone = obj:Clone()
            local parent = obj.Parent
            local name = obj.Name
            
            table.insert(history, {clone = clone, parent = parent, name = name})
            
            -- Hapus highlight
            if data.highlight then data.highlight:Destroy() end
            
            -- Hapus objek
            pcall(function()
                obj:Destroy()
            end)
            
            count = count + 1
        end
    end
    
    table.clear(selectedObjects)
    UpdateDeleteButton()
    infoLabel.Text = "✅ " .. count .. " objek dihapus!"
end)

-- Undo
btnUndo.MouseButton1Click:Connect(function()
    if #history == 0 then
        infoLabel.Text = "Tidak ada yang di-undo"
        return
    end
    
    local data = table.remove(history)
    local newObj = data.clone:Clone()
    newObj.Name = data.name
    pcall(function()
        newObj.Parent = data.parent
    end)
    
    infoLabel.Text = "↩️ Undo: " .. data.name
end)

-- ==========================================
-- FUNGSI ANTI AIR
-- ==========================================
local function disableSwimming()
    if humanoid then
        humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
        humanoid.SwimSpeed = 0
        humanoid.AutoRotate = true
        humanoid.PlatformStand = false
    end
end

local function removeWaterPhysics()
    local terrain = Workspace:FindFirstChild("Terrain")
    if terrain then
        pcall(function()
            terrain.WaterTransparency = 1
            terrain.WaterWaveSize = 0
            terrain.WaterWaveSpeed = 0
            terrain.WaterReflectance = 0
        end)
    end
    
    for _, v in pairs(Workspace:GetDescendants()) do
        pcall(function()
            if v:IsA("Part") or v:IsA("MeshPart") or v:IsA("BasePart") then
                local isWater = false
                if v.Name:lower():find("water") then
                    isWater = true
                elseif v.Name:lower():find("air") then
                    isWater = true
                elseif v.Material == Enum.Material.Water then
                    isWater = true
                end
                
                if isWater then
                    v.Transparency = 1
                    v.CanCollide = false
                    v.Material = Enum.Material.Air
                    v.Anchored = false
                end
            end
        end)
    end
end

btnAntiAir.MouseButton1Click:Connect(function()
    antiAirEnabled = not antiAirEnabled
    
    if antiAirEnabled then
        btnAntiAir.Text = "🟢 AIR: ON"
        btnAntiAir.BackgroundColor3 = Color3.fromRGB(50, 150, 100)
        disableSwimming()
        removeWaterPhysics()
        
        spawn(function()
            while antiAirEnabled do
                pcall(function()
                    removeWaterPhysics()
                    if humanoid then
                        humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, false)
                    end
                end)
                wait(1)
            end
        end)
    else
        btnAntiAir.Text = "🔴 AIR: OFF"
        btnAntiAir.BackgroundColor3 = Color3.fromRGB(150, 50, 50)
        
        if humanoid then
            pcall(function()
                humanoid:SetStateEnabled(Enum.HumanoidStateType.Swimming, true)
                humanoid.SwimSpeed = 16
            end)
        end
        Workspace.Gravity = 196.2
    end
end)

-- Respawn handler
lp.CharacterAdded:Connect(function(newCharacter)
    character = newCharacter
    humanoid = character:WaitForChild("Humanoid")
    
    if antiAirEnabled then
        spawn(function()
            wait(1)
            disableSwimming()
        end)
    end
end)

-- ==========================================
-- DRAG SYSTEM
-- ==========================================
local dragging = false
local dragInput, dragStart, startPos

titleBar.InputBegan:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseButton1 then
        dragging = true
        dragStart = input.Position
        startPos = mainFrame.Position
        input.Changed:Connect(function()
            if input.UserInputState == Enum.UserInputState.End then dragging = false end
        end)
    end
end)

titleBar.InputChanged:Connect(function(input)
    if input.UserInputType == Enum.UserInputType.Touch or input.UserInputType == Enum.UserInputType.MouseMovement then
        dragInput = input
    end
end)

UIS.InputChanged:Connect(function(input)
    if input == dragInput and dragging then
        local delta = input.Position - dragStart
        mainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
    end
end)

